DATABASE_URL=postgres://postgres:postgres@localhost:5432/adsolute
APP_SECRET_ENCRYPTION_KEY=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_xxxxx

# For Trigger tasks to call this app's tRPC API.
ADSOLUTE_API_URL=https://your-app.vercel.app
ADSOLUTE_WORKER_SECRET=change-me-to-a-long-random-secret

# Optional comma-separated allowlist. Leave empty to enable all orgs.
ADSOLUTE_META_SYNC_ORGANIZATION_IDS=

# Optional: only needed for the local CLI/API-key workflows, not Trigger workers.
ADSOLUTE_API_KEY=
